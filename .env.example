# Vultr Serverless Inference (OpenAI-compatible). Copy the base URL, API key and
# a model name from the Serverless Inference page in the Vultr console.
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=

# Sandbox settings (no inline comments: systemd reads this file).
# SANDBOX_MODE: docker = isolated; local = NO isolation, development only.
SANDBOX_MODE=docker
# SANDBOX_RUNTIME: runsc = gVisor; runc = plain Docker, only if gVisor is unavailable.
SANDBOX_RUNTIME=runsc
SANDBOX_IMAGE=physsandbox-runner:latest
SANDBOX_TIMEOUT_S=30
# Where each analysis step's result is stored for the PDF report (default: results/ in the app
# directory, capped at RESULTS_MAX_MB). Keep it with the lab notebook; reports need both.
# RESULTS_DIR=/opt/physsandbox/results
# RESULTS_MAX_MB=200
